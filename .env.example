# Local development
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud deployment (switch provider to hf)
# LLM_PROVIDER=hf
# HF_TOKEN=your_token_here
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# OpenStreetMap endpoints (can be swapped if needed)
OSM_USER_AGENT=AutoSageAI/1.0-hackathon
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Whisper voice input
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local demo appointment state
SERVICE_DB_PATH=autosage_service.db

# Optional LangSmith observability for LangChain traces
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=AutoSage-AI
